{
  "manifest_version": 3,
  "name": "AiTestX - 自动化分析提单助手",
  "version": "0.1.0",
  "description": "AiTest 自动化测试失败用例分析与一键提单 (PingCode / PLM)",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://10.20.65.23:3000/*",
    "http://10.20.24.30/*",
    "http://localhost:8000/*",
    "https://plm.twsc.com.cn/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://10.20.65.23:3000/Dml/AiTest/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "js/config.js",
        "content/ai-test-extractor.js"
      ],
      "css": [
        "content/ai-test.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://10.20.24.30/*",
        "http://localhost:8000/*"
      ],
      "js": [
        "js/config.js",
        "content/pingcode-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://plm.twsc.com.cn/*"
      ],
      "js": [
        "js/config.js",
        "content/plm-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "AiTestX - 自动化分析提单",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}