{
  "manifest_version": 3,
  "name": "TestMateX - AiTest 至 PingCode 提单助手",
  "version": "0.1.0",
  "description": "AiTest 自动化测试失败用例一键提单到 PingCode 问题单系统",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "http://10.20.65.23:3000/*",
    "http://10.20.24.30/*"
  ],
  "background": {
    "service_worker": "background/sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://10.20.65.23:3000/Dml/AiTest/*"
      ],
      "js": [
        "content/ai-test-extractor.js"
      ],
      "css": [
        "content/ai-test.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "http://10.20.24.30/*"
      ],
      "js": [
        "content/pingcode-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "TestMateX - 打开提单面板",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
